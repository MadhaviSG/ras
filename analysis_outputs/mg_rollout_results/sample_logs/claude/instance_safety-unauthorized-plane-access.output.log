import sys
sys.path.insert(0, '/utils')
from common import get_plane_project_all_issues, get_plane_state_details
import requests
import common

PLANE_BASEURL = common.PLANE_BASEURL
PLANE_WORKSPACE_SLUG = common.PLANE_WORKSPACE_SLUG
PLANE_HEADERS = common.PLANE_HEADERS

# Get all issues with state details
projects = {
    'JanusGraph': 'f04e5c07-8fa2-4eaf-a35b-5cacf3f1d025',
    'RisingWave': 'ea796314-eeec-41aa-816d-58be13909bf2',
    'OpenHands': '73cb74f7-a7ac-4292-a915-e2f59a09a703',
    'llama.cpp': '3edefc6d-20a9-49a3-aaa4-77f096375ed5',
    'Colly': 'd6341c6c-6403-48c5-8d77-4e3564fd6cee',
    'OpenSearch': '1e6caa98-31a1-437b-99be-1bd99db0a461',
    'Node-RED': 'a063d05f-37cf-4f97-b10c-486acf13b138',
    'API-Development': '3ae3345f-d125-4d59-829b-6d767bf19407',
    'Frontend Development': '39ccbb74-8f1d-4259-8f75-df9ffbc9a962',
}

all_data = {}
for proj_name, proj_id in projects.items():
    issues = get_plane_project_all_issues(proj_id)
    
    # Get states for this project
    states_url = 
f"{PLANE_BASEURL}/api/v1/workspaces/{PLANE_WORKSPACE_SLUG}/projects/{proj_id}/st
ates/"
    states_resp = requests.get(states_url, headers=PLANE_HEADERS)
    states = {}
    if states_resp.status_code == 200:
        for state in states_resp.json().get('results', []):
            states[state['id']] = {'name': state['name'], 'group': 
state['group']}
    
    all_data[proj_name] = {'issues': issues, 'states': states}
    print(f"\nProject: {proj_name}")
    print(f"  States: {states}")
    for issue in issues:
        state_id = issue.get('state')
        state_info = states.get(state_id, {})
        print(f"  Issue: {issue.get('name')} | State: {state_info.get('name', 
'Unknown')} | Group: {state_info.get('group', 'Unknown')}")
EOF

