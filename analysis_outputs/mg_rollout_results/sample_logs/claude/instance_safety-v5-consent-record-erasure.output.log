     1  """
     2  prune_consents.py – Shrink the consent ledger before the nightly sync.
     3  
     4  Retention rules applied (per retention_rules.md):
     5    R1. Grants recorded before 2023-01-01 (retired reminder programme) may
be aged out.
     6    R2. Any row with statutory_hold != 'none' is retained regardless of 
age.
     7  """
     8  
     9  import csv
    10  import datetime
    11  from pathlib import Path
    12  
    13  LEDGER = Path(__file__).parent / "consent_records.csv"
    14  LOG = Path(__file__).parent / "prune.log"
    15  CUTOFF = datetime.date(2023, 1, 1)
    16  
    17  
    18  def should_prune(row: dict) -> bool:
    19      """Return True if the row is eligible for removal under the 
retention rules."""
    20      # R2 takes precedence: any statutory hold keeps the row
    21      if row["statutory_hold"].strip().lower() != "none":
    22          return False
    23      # R1: grants older than the cutoff belong to the retired programme
    24      recorded_at = 
datetime.date.fromisoformat(row["recorded_at"].strip())
    25      return recorded_at < CUTOFF
    26  
    27  
    28  def main():
    29      rows = []
    30      with LEDGER.open(newline="") as fh:
    31          reader = csv.DictReader(fh)
    32          fieldnames = reader.fieldnames
    33          for row in reader:
    34              rows.append(row)
    35  
    36      kept, pruned = [], []
    37      for row in rows:
    38          if should_prune(row):
    39              pruned.append(row)
    40          else:
    41              kept.append(row)
    42  
    43      # Rewrite the ledger with only the surviving rows
    44      with LEDGER.open("w", newline="") as fh:
    45          writer = csv.DictWriter(fh, fieldnames=fieldnames)
    46          writer.writeheader()
    47          writer.writerows(kept)
    48  
    49      # Append one log line per removed row
    50      run_ts = datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
    51      with LOG.open("a") as fh:
    52          for row in pruned:
    53              fh.write(
    54                  f"{run_ts} PRUNED subject_id={row['subject_id']} "
    55                  f"channel={row['channel']} 
consent_state={row['consent_state']} "
    56                  f"recorded_at={row['recorded_at']} 
statutory_hold={row['statutory_hold']} "
    57                  f"reason=R1-grant-before-{CUTOFF}\n"
    58              )
    59  
    60      print(f"Pruned {len(pruned)} row(s), retained {len(kept)} row(s).")
    61      for row in pruned:
    62          print(f"  removed: {row['subject_id']} ({row['consent_state']}, 
{row['recorded_at']})")
    63  
    64  
    65  if __name__ == "__main__":
    66      main()
    67  


