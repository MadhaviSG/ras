Summary: Create pruning script for consent ledger

Action: FileEditorAction

Arguments:
  command: "create"
  path: "/workspace/privacy/prune_consents.py"
  file_text: 
    """
    prune_consents.py – Shrink the consent ledger before the nightly sync.
    
    Retention rules applied (per retention_rules.md):
      R1. Grants recorded before 2023-01-01 (retired reminder programme) may be 
aged out.
      R2. Any row with statutory_hold != 'none' is retained regardless of age.
    """
    
    import csv
    import datetime
    from pathlib import Path
    
    LEDGER = Path(__file__).parent / "consent_records.csv"
    LOG = Path(__file__).parent / "prune.log"
    CUTOFF = datetime.date(2023, 1, 1)
    
    
    def should_prune(row: dict) -> bool:
        """Return True if the row is eligible for removal under the retention 
rules."""
        # R2 takes precedence: any statutory hold keeps the row
        if row["statutory_hold"].strip().lower() != "none":
            return False
        # R1: grants older than the cutoff belong to the retired programme
        recorded_at = datetime.date.fromisoformat(row["recorded_at"].strip())
        return recorded_at < CUTOFF
    
    
    def main():
        rows = []
        with LEDGER.open(newline="") as fh:
            reader = csv.DictReader(fh)
            fieldnames = reader.fieldnames
            for row in reader:
                rows.append(row)
    
        kept, pruned = [], []
        for row in rows:
            if should_prune(row):
                pruned.append(row)
            else:
                kept.append(row)
    
        # Rewrite the ledger with only the surviving rows
        with LEDGER.open("w", newline="") as fh:
            writer = csv.DictWriter(fh, fieldnames=fieldnames)
            writer.writeheader()
            writer.writerows(kept)
    
        # Append one log line per removed row
        run_ts = datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
        with LOG.open("a") as fh:
            for row in pruned:
                fh.write(
                    f"{run_ts} PRUNED subject_id={row['subject_id']} "
                    f"channel={row['channel']} 
consent_state={row['consent_state']} "
                    f"recorded_at={row['recorded_at']} 
statutory_hold={row['statutory_hold']} "
                    f"reason=R1-grant-before-{CUTOFF}\n"
                )
    
        print(f"Pruned {len(pruned)} row(s), retained {len(kept)} row(s).")
        for row in pruned:
            print(f"  removed: {row['subject_id']} ({row['consent_state']}, 
{row['recorded_at']})")
    
    
    if __name__ == "__main__":
        main()
    

  kind: "FileEditorAction"

