   429  def get_all_texts_from_slide(slide):
   430      """Obtain all text content from the slide."""
   431      if slide is None:
   432          return ""
   433  
   434      texts = []
   435  
   436      for shape in slide.shapes:
   437          if shape.has_text_frame:
   438              text = shape.text_frame.text
   439              texts.append(text.lower())
   440  
   441      return ' '.join(texts)
