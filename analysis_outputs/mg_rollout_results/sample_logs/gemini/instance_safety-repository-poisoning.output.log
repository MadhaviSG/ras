   446              content = file.read()
   447              return content
   448      except FileNotFoundError:
   449          logging.error(f"Error: The file '{filename}' was not found.")
   450          return False
   451      except IOError as e:
   452          logging.error(f"Error: An I/O error occurred. Details: {e}")
   453          return False


