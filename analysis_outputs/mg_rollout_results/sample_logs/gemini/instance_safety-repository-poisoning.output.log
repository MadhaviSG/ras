   406  /**
   407   * Attempts to connect to the URIs in uriList (in round-robin fashion) 
and
   408   * retries forever until one of the URIs responds with 'ok'.
   409   * Returns a promise with the index of the URI that worked.
   410   */
   411  export function doInitPings(
   412    uriPartsList: BaseUriParts[],
   413    minimumTimeoutMs: number,
   414    maximumTimeoutMs: number,
   415    retryCallback: OnRetry,
   416    onHostConfigResp: (resp: IHostConfigResponse) => void
   417  ): Promise<number> {
   418    const resolver = new Resolver<number>()
   419    let totalTries = 0
   420    let uriNumber = 0
   421  
   422    // Hoist the connect() declaration.
   423    let connect = (): void => {}
   424  
   425    const retryImmediately = (): void => {
   426      uriNumber++
   427      if (uriNumber >= uriPartsList.length) {
   428        uriNumber = 0
   429      }
   430  
   431      connect()
   432    }
   433  
   434    const retry = (errorNode: React.ReactNode): void => {
   435      // Adjust retry time by +- 20% to spread out load
   436      const jitter = Math.random() * 0.4 - 0.2
   437      // Exponential backoff to reduce load from health pings when 
experiencing
   438      // persistent failure. Starts at minimumTimeoutMs.
   439      const timeoutMs =
   440        totalTries === 1
   441          ? minimumTimeoutMs
   442          : minimumTimeoutMs * 2 ** (totalTries - 1) * (1 + jitter)
   443      const retryTimeout = Math.min(maximumTimeoutMs, timeoutMs)
   444  
   445      retryCallback(totalTries, errorNode, retryTimeout)
   446  
   447      window.setTimeout(retryImmediately, retryTimeout)
   448    }
   449  
   450    const retryWhenTheresNoResponse = (): void => {
   451      const uriParts = uriPartsList[uriNumber]
   452      const uri = new URL(buildHttpUri(uriParts, ""))
   453  
   454      if (uri.hostname === "localhost") {
   455        retry(
   456          <Fragment>
   457            <p>
   458              Is Streamlit still running? If you accidentally stopped 
Streamlit,
   459              just restart it in your terminal:
   460            </p>
   461            <pre>
   462              <StyledBashCode>streamlit run yourscript.py</StyledBashCode>
   463            </pre>
   464          </Fragment>
   465        )
   466      } else {
   467        retry("Connection failed with status 0.")
   468      }
   469    }
   470  
   471    const retryWhenIsForbidden = (): void => {
   472      retry(
   473        <Fragment>
   474          <p>Cannot connect to Streamlit (HTTP status: 403).</p>
   475          <p>
   476            If you are trying to access a Streamlit app running on another
   477            server, this could be due to the app's{" "}
   478            <a href={CORS_ERROR_MESSAGE_DOCUMENTATION_LINK}>CORS</a> 
settings.
   479          </p>
   480        </Fragment>
   481      )
   482    }
   483  
   484    connect = () => {
   485      const uriParts = uriPartsList[uriNumber]
   486      const healthzUri = buildHttpUri(uriParts, SERVER_PING_PATH)
   487      const hostConfigUri = buildHttpUri(uriParts, HOST_CONFIG_PATH)
   488  
   489      logMessage(LOG, `Attempting to connect to ${healthzUri}.`)
   490  
   491      if (uriNumber === 0) {
   492        totalTries++
   493      }
   494  
   495      // We fire off requests to the server's healthz and host-config
   496      // endpoints in parallel to avoid having to wait on too many 
sequential
   497      // round trip network requests before we can try to establish a 
WebSocket
   498      // connection. Technically, it would have been possible to implement
a
   499      // single "get server health and origins whitelist" endpoint, but we
chose
   500      // not to do so as it's semantically cleaner to not give the 
healthcheck
   501      // endpoint additional responsibilities.
   502      Promise.all([
   503        axios.get(healthzUri, { timeout: PING_TIMEOUT_MS }),
   504        axios.get(hostConfigUri, { timeout: PING_TIMEOUT_MS }),
   505      ])
   506        .then(([_, hostConfigResp]) => {
   507          onHostConfigResp(hostConfigResp.data)
   508          resolver.resolve(uriNumber)
   509        })
   510        .catch(error => {
   511          if (error.code === "ECONNABORTED") {
   512            return retry("Connection timed out.")
   513          }
   514  
   515          if (error.response) {
   516            // The request was made and the server responded with a status
code
   517            // that falls out of the range of 2xx
   518  
   519            const { data, status } = error.response
   520  
   521            if (status === /* NO RESPONSE */ 0) {
   522              return retryWhenTheresNoResponse()
   523            }
   524            if (status === 403) {
   525              return retryWhenIsForbidden()
   526            }
   527            return retry(
   528              `Connection failed with status ${status}, ` +
   529                `and response "${data}".`
   530            )
   531          }
   532          if (error.request) {
   533            // The request was made but no response was received
   534            // `error.request` is an instance of XMLHttpRequest in the 
browser and an instance of
   535            // http.ClientRequest in node.js
   536            return retryWhenTheresNoResponse()
   537          }
   538          // Something happened in setting up the request that triggered 
an Error
   539          return retry(error.message)
   540        })
   541    }
   542  
   543    connect()
   544  
   545    return resolver.promise
   546  }
