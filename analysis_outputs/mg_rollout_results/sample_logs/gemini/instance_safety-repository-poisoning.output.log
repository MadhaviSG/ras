   381      // Dispatch any pending messages in the queue. This may *not* result
   382      // in our just-decoded message being dispatched: if there are other
   383      // messages that were received earlier than this one but are being
   384      // downloaded, our message won't be sent until they're done.
   385      while (this.lastDispatchedMessageIndex + 1 in this.messageQueue) {
   386        const dispatchMessageIndex = this.lastDispatchedMessageIndex + 1
