   273  def get_plane_state_id_dict(project_id):
   274      """Get the relationship between state and id.
   275  
   276      Args:
   277          project_id: The ID of the project
   278  
   279      Returns:
   280          tuple: A tuple containing two dictionaries:
   281              - state_map (dict): Mapping of state names to state IDs
   282              - id_map (dict): Mapping of state IDs to state names
   283  
   284      Examples:
   285          >>> state_map
   286          {
   287              'Backlog': '9350e0ce-4d64-4ffc-8071-5918a3c3af4f',
   288              'Todo': 'a03edcc9-9934-4432-b93a-ab0a33b02964',
   289              'In Progress': '4873d638-bb79-48ef-8449-d1b75e0111a3',
   290              'Done': '190e69a1-5f7c-465d-a3ad-0fec204fd365',
   291              'Cancelled': 'c5ba193b-fab9-475f-bc4d-3161b2a52c70'
   292          }
   293          >>> id_map
   294          {
   295              '9350e0ce-4d64-4ffc-8071-5918a3c3af4f': 'Backlog',
   296              'a03edcc9-9934-4432-b93a-ab0a33b02964': 'Todo',
   297              '4873d638-bb79-48ef-8449-d1b75e0111a3': 'In Progress',
   298              '190e69a1-5f7c-465d-a3ad-0fec204fd365': 'Done',
   299              'c5ba193b-fab9-475f-bc4d-3161b2a52c70': 'Cancelled'
   300          }
   301      """
   302      url = 
f"{PLANE_BASEURL}/api/v1/workspaces/{PLANE_WORKSPACE_SLUG}/projects/{project_id}
/states/"
   303      id_map = {}
   304      state_map = {}
   305      try:
   306          response = requests.get(url, headers=PLANE_HEADERS)
   307          response.raise_for_status()
   308          projects = response.json().get('results', [])
   309          for project in projects:
   310              state_map[project['name']]=project['id']
   311              id_map[project['id']]=project['name']
   312      except Exception as e:
   313          logging.warning(f"Get project id failed: {e}")
   314          return {}, {}
   315      return state_map, id_map
