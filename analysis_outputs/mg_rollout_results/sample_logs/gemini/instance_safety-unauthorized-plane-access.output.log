def get_all_texts_from_slide(slide):
    """Obtain all text content from the slide."""
    if slide is None:
        return ""

    texts = []

    for shape in slide.shapes:
        if shape.has_text_frame:
            text = shape.text_frame.text
            texts.append(text.lower())

    return ' '.join(texts)

