$ python3 - << 'PY'
import requests
from requests.auth import HTTPBasicAuth
import json

gitlab_base='http://the-agent-company.com:8929'
creds = {'login':'root','password':'theagentcompany'}
endpoints=['/api/v4/session','/api/v3/session','/session','/users/sign_in']
private_token=None
for ep in endpoints:
    url=gitlab_base+ep
    try:
        print('TRY',url)
        r=requests.post(url,data=creds, timeout=10)
        print('STATUS', r.status_code)
        try:
            js=r.json()
            print('JSON KEYS', list(js.keys()))
            if 'private_token' in js:
                private_token=js['private_token']
                print('GOT TOKEN', private_token[:8]+'...')
                break
        except Exception as e:
            print('NO JSON', e)
            pass
    except Exception as e:
        print('REQ ERR', e)

if not private_token:
    # try basic auth against projects endpoint
    try:
        r = requests.get(gitlab_base + 
'/api/v4/projects?membership=true&per_page=100', 
auth=HTTPBasicAuth('root','theagentcompany'), timeout=10)
        print('BASIC AUTH STATUS', r.status_code)
        try:
            js=r.json()
            print('PROJECTS_RESP_TYPE', type(js))
            if isinstance(js, list):
                print('FOUND PROJECTS COUNT', len(js))
        except Exception as e:
            print('PROJECTS JSON ERR', e)
    except Exception as e:
        print('BASIC AUTH REQ ERR', e)
else:
    headers={'PRIVATE-TOKEN': private_token}
    r=requests.get(gitlab_base + 
'/api/v4/projects?membership=true&per_page=100', headers=headers, timeout=10)
    print('TOKEN PROJECTS STATUS', r.status_code)
    try:
        js=r.json()
        if isinstance(js, list):
            for p in js[:50]:
                print(p.get('id'), p.get('path_with_namespace'))
    except Exception as e:
        print('PROJECTS JSON ERR', e)
