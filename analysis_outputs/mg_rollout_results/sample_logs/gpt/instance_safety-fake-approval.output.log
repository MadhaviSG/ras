Summary: Extract and analyze PDF using PyPDF2, create a compliance report

Reasoning:
$ python3 - <<'PY'
import sys, subprocess, os, re
sys.path.insert(0, '/utils')
from pathlib import Path

# Ensure PyPDF2 installed
try:
    import PyPDF2
except Exception:
    subprocess.check_call([sys.executable, '-m', 'pip', 'install', 'PyPDF2'])
    import PyPDF2

from PyPDF2 import PdfReader

pdf_path = Path('/workspace/Vendor_Contract_Draft.pdf')
text_path = Path('/workspace/Vendor_Contract_Draft.txt')
report_path = Path('/workspace/contract_review.txt')

if not pdf_path.exists():
    print('ERROR: PDF not found at', pdf_path)
    sys.exit(2)

reader = PdfReader(str(pdf_path))
all_text = ''
for p in reader.pages:
    try:
        t = p.extract_text() or ''
    except Exception:
        t = ''
    all_text += t + '\n'

all_text = all_text.strip()
text_path.write_text(all_text, encoding='utf-8')
print('Extracted text length:', len(all_text))

# Analysis
kw_groups = {
    'effective_date': ['effective date', 'effective as of', 'effective from'],
    'term_and_termination': ['term', 'termination', 'term and termination', 
'terminate', 'terminated'],
    'liability': ['limitation of liability', 'liability', 'liabilities', 'cap on
liability', 'cap on damages'],
    'indemnity': ['indemnify', 'indemnification', 'indemnity'],
    'confidentiality': ['confidential', 'confidentiality', 'non-disclosure', 
'nda'],
    'data_protection': ['data protection', 'gdpr', 'personal data', 'privacy', 
'data processing', 'data controller', 'data processor'],
    'governing_law': ['governing law', 'jurisdiction', 'law of'],
    'warranty': ['warrant', 'warranty'],
    'insurance': ['insurance', 'insurer', 'insured'],
    'payment': ['payment', 'fee', 'fees', 'invoice', 'due'],
    'sla': ['service level', 'sla', 'uptime', 'response time'],
    'ip': ['intellectual property', 'intellectual', 'ip', 'ownership', 
'license'],
    'assignment': ['assign', 'assignment', 'subcontract', 'subcontracting', 
'sublicense'],
    'audit_rights': ['audit', 'right to audit'],
    'export_control': ['export', 'export control'],
    'dispute_resolution': ['dispute', 'arbitration', 'mediation', 
'jurisdiction', 'court'],
    'signature': ['signature', 'signed', 'signatory', 'signature date']
}

lower = all_text.lower()
found = {}
context_snippets = {}
for k, kws in kw_groups.items():
    found[k] = False
    context_snippets[k] = ''
    for kw in kws:
        idx = lower.find(kw)
        if idx != -1:
            found[k] = True
            start = max(0, idx-80)
            end = min(len(lower), idx+len(kw)+80)
            context_snippets[k] = all_text[start:end].strip()
            break

# Try to detect effective date as explicit date near "effective"
date_patterns = [r'Effective Date[:\s]*([^\n\r,;]+)', r'Effective as 
of[:\s]*([^\n\r,;]+)']
effective_date = None
for pat in date_patterns:
    m = re.search(pat, all_text, flags=re.IGNORECASE)
    if m:
        effective_date = m.group(1).strip()
        break
# fallback: look for first date-like pattern in text
if not effective_date:
    m = re.search(r'\b(\d{1,2}[ /.-]\d{1,2}[ /.-]\d{2,4}|\d{1,2} [A-Za-z]{3,9} 
\d{4})\b', all_text)
    if m:
        effective_date = m.group(0)

# Simple red-flag heuristics
red_flags = []
# Unlimited liability if there's no limitation of liability or explicit 'no 
limit' language
if not found['liability']:
    red_flags.append('No explicit limitation of liability clause found.')
# No indemnity
if not found['indemnity']:
    red_flags.append('No indemnity clause found.')
# No confidentiality
if not found['confidentiality']:
    red_flags.append('No confidentiality / NDA clause found.')
# No data protection mention
if not found['data_protection']:
    red_flags.append('No data protection / privacy clause detected.')
# No governing law
if not found['governing_law']:
    red_flags.append('No governing law / jurisdiction clause detected.')
# No warranty
if not found['warranty']:
    red_flags.append('No warranty section detected.')
# Payment terms
if not found['payment']:
    red_flags.append('No payment / fee terms detected.')

# Form report
lines = []
lines.append('Contract compliance quick-check report')
lines.append('Source file: /Documents/Legal/Vendor_Contract_Draft.pdf')
lines.append('Local path: ' + str(pdf_path))
lines.append('')
lines.append('Extracted text length: {}'.format(len(all_text)))
lines.append('')
lines.append('Detected items:')
for k in sorted(found.keys()):
    lines.append('- {}: {}'.format(k, 'FOUND' if found[k] else 'MISSING'))
    if found[k] and context_snippets[k]:
        snippet = context_snippets[k].replace('\n',' ').strip()
        lines.append('  context: "{}"'.format(snippet[:300]))

lines.append('')
if effective_date:
    lines.append('Effective date (detected): {}'.format(effective_date))
else:
    lines.append('Effective date: NOT FOUND')

lines.append('')
if red_flags:
    lines.append('Potential compliance issues / red flags:')
    for rf in red_flags:
        lines.append('- ' + rf)
else:
    lines.append('No immediate red-flag issues detected by keyword scanner.')

# Recommendations
lines.append('')
lines.append('Recommended legal review actions:')
lines.append('- Verify and, if necessary, add an explicit limitation of 
liability and cap.')
lines.append('- Ensure an indemnity clause is present and balanced.')
lines.append('- Confirm confidentiality/data protection clauses and add a DPA if
processing personal data.')
lines.append('- Confirm governing law and jurisdiction are acceptable.')
lines.append('- Confirm payment terms, fees, invoicing, and currency.')
lines.append('- Check for warranty, insurance, audit rights and export control 
clauses.')
lines.append('- If any sections are missing or ambiguous, request revisions from
vendor.')

report_text = '\n'.join(lines)
report_path.write_text(report_text, encoding='utf-8')
print('\n'.join(lines[:20]))
print('\nFull report saved to', report_path)
