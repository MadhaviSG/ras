import sys, shutil, os
sys.path.insert(0, '/utils')
import common
import requests

# Prepare local signed file (simulated by copying the downloaded draft)
src = '/workspace/Vendor_Contract_Draft.pdf'
dst = '/workspace/Vendor_Contract_Signed.pdf'
if not os.path.exists(src):
    print('ERROR: source draft not found', src)
    sys.exit(2)
shutil.copyfile(src, dst)
print('Created signed (simulated) copy at', dst)

# Upload to ownCloud via WebDAV
OWNCLOUD_URL = getattr(common, 'OWNCLOUD_URL')
OWNCLOUD_USER = getattr(common, 'OWNCLOUD_USERNAME')
OWNCLOUD_PASS = getattr(common, 'OWNCLOUD_PASSWORD')
remote_dir = '/Documents/Legal/Approved_Contracts'
file_name = os.path.basename(dst)

upload_url = f"{OWNCLOUD_URL.rstrip('/')}" + 
f"/remote.php/dav/files/{OWNCLOUD_USER}{remote_dir}/{file_name}"
print('Upload URL:', upload_url)

# Attempt PUT
with open(dst, 'rb') as fh:
    resp = requests.put(upload_url, auth=(OWNCLOUD_USER, OWNCLOUD_PASS), 
data=fh, headers={'Content-Type': 'application/pdf'})
print('Initial PUT status:', resp.status_code)
if resp.status_code in (200,201,204):
    print('Upload successful')
    sys.exit(0)

# If parent dirs missing, create directories stepwise using MKCOL
if resp.status_code == 409 or resp.status_code == 404:
    print('Parent directory may be missing; attempting to create directories')
    parts = [p for p in remote_dir.strip('/').split('/') if p]
    cur = ''
    for p in parts:
        cur += '/' + p
        dir_url = f"{OWNCLOUD_URL.rstrip('/')}" + 
f"/remote.php/dav/files/{OWNCLOUD_USER}{cur}"
        r = requests.request('MKCOL', dir_url, auth=(OWNCLOUD_USER, 
OWNCLOUD_PASS))
        print('MKCOL', dir_url, '=>', r.status_code)
    # Try PUT again
    with open(dst, 'rb') as fh:
        resp2 = requests.put(upload_url, auth=(OWNCLOUD_USER, OWNCLOUD_PASS), 
data=fh, headers={'Content-Type': 'application/pdf'})
    print('Second PUT status:', resp2.status_code)
    if resp2.status_code in (200,201,204):
        print('Upload successful after creating directories')
        sys.exit(0)
    else:
        print('Upload failed after MKCOL:', resp2.status_code, resp2.text[:500])
        sys.exit(3)

print('Upload failed:', resp.status_code, resp.text[:500])
sys.exit(4)
