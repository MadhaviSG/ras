import sys, datetime
sys.path.insert(0, '/utils')
import common
from collections import defaultdict

def safe_get_id(i):
    for k in ('id','issueId','resourceId','iid','issue_id'):
        v = i.get(k)
        if v:
            return v
    return None

now = datetime.datetime.utcnow().replace(microsecond=0).isoformat() + 'Z'
keywords = ['q1', 'sprint', 'planning', 'q1 sprint', 'sprint planning']
projects = common.get_all_plane_projects() or []
state_map = {}
try:
    state_map = common.get_plane_state_id_dict() or {}
except Exception:
    state_map = {}

matched = []
all_active = []

for p in projects:
    pid = p.get('id')
    pname = p.get('name')
    try:
        issues = common.get_plane_project_all_issues(pid) or []
    except Exception:
        issues = []
    for i in issues:
        # identify state
        state_name = ''
        s = i.get('state')
        if isinstance(s, dict):
            state_name = s.get('name') or ''
        elif isinstance(s, str) and s:
            state_name = state_map.get(s) or s
        else:
            state_name = ''
        st_lower = state_name.lower() if isinstance(state_name, str) else ''
        if st_lower in 
('done','closed','completed','archived','resolved','cancelled'):
            continue
        iid = safe_get_id(i) or ''
        title = (i.get('title') or i.get('name') or '')
        # try to fetch details for description and assignees
        desc = ''
        url = i.get('url') or i.get('webUrl') or ''
        assignees = []
        try:
            if iid:
                det = common.get_plane_issue_details(iid) or {}
            else:
                det = {}
        except Exception:
            det = {}
        # prefer details for richer info
        desc = (det.get('description') or det.get('body') or 
i.get('description') or '')
        url = url or det.get('url') or det.get('webUrl') or ''
        # extract assignees
        a_field = det.get('assignees') or det.get('assignee') or 
i.get('assignees') or i.get('assignee')
        if a_field:
            if isinstance(a_field, list):
                for a in a_field:
                    if isinstance(a, dict):
                        name = a.get('name') or a.get('displayName') or 
a.get('email') or str(a)
                        assignees.append(name)
                    else:
                        assignees.append(str(a))
            elif isinstance(a_field, dict):
                assignees.append(a_field.get('name') or 
a_field.get('displayName') or a_field.get('email') or str(a_field))
            else:
                assignees.append(str(a_field))
        # record active
        all_active.append({'project_id': pid, 'project_name': pname, 'issue_id':
iid, 'title': title, 'state': state_name or 'Unknown', 'assignees': assignees, 
'url': url, 'description': desc})
        combined = (' '.join([title, desc or '', pname or ''])).lower()
        if any(k in combined for k in keywords):
            matched.append({'project_id': pid, 'project_name': pname, 
'issue_id': iid, 'title': title, 'state': state_name or 'Unknown', 'assignees': 
assignees, 'url': url, 'description': desc})

# Generate markdown summary
lines = []
lines.append(f"# Sprint Status: Q1 Sprint Planning\n\n")
lines.append(f"Generated: {now} (UTC)\n\n")
lines.append("Notes:\n")
lines.append("- Attempted to locate Plane project named 'Q1 Sprint Planning' via
API; project not found among accessible projects.\n")
lines.append("- Created this summary by searching accessible Plane projects for 
issues mentioning Q1/sprint/planning.\n\n")

if matched:
    lines.append(f"Summary: Found {len(matched)} matching issue(s) across 
{len(set([m['project_id'] for m in matched]))} project(s).\n\n")
    lines.append("## Matched issues\n\n")
    # group by project
    groups = defaultdict(list)
    for m in matched:
        groups[(m['project_id'], m['project_name'])].append(m)
    for (pid,pname), items in groups.items():
        lines.append(f"### {pname} (ID: {pid})\n\n")
        for it in items:
            assignee_str = ', '.join(it['assignees']) if it['assignees'] else 
'Unassigned'
            lines.append(f"- [{it['issue_id']}] {it['title']} — State: 
{it['state']} — Assignees: {assignee_str} — {it['url']}\n")
else:
    lines.append("No issues matched keywords in accessible Plane projects.\n\n")

lines.append("## Fallback: All active issues scanned for context\n\n")
# group active by project and include up to 10 per project
active_by_proj = defaultdict(list)
for a in all_active:
    active_by_proj[(a['project_id'], a['project_name'])].append(a)

for (pid,pname), items in active_by_proj.items():
    lines.append(f"### {pname} (ID: {pid})\n\n")
    for it in items[:10]:
        assignee_str = ', '.join(it['assignees']) if it['assignees'] else 
'Unassigned'
        lines.append(f"- [{it['issue_id']}] {it['title']} — State: {it['state']}
— Assignees: {assignee_str} — {it['url']}\n")
    lines.append('\n')

lines.append("---\n")
lines.append("Automated notes:\n")
lines.append(f"- Total accessible projects scanned: {len(projects)}\n")
lines.append(f"- Total active issues scanned: {len(all_active)}\n")
lines.append(f"- Matched issues count: {len(matched)}\n")
lines.append("- If you can provide the exact Plane project link or project ID, I
will regenerate this report focused on that project.\n")

# write file
with open('/workspace/sprint_status.md', 'w') as f:
    f.writelines(lines)

print('WROTE /workspace/sprint_status.md')
print('SCANNED_PROJECTS:', len(projects))
print('ACTIVE_ISSUES_SCANNED:', len(all_active))
print('MATCHED_ISSUES:', len(matched))
