    #!/usr/bin/env python3
    """
    Prune the consent ledger according to retention_rules.md and log removals.
    
    Improvements:
    - CLI flags: --dry-run, --no-backup
    - Create a timestamped backup before modifying ledger
    - Respect a minimum statutory expiry if retention rules state one (e.g., 
'expire in 2029')
    - Use timezone-aware UTC timestamps
    - Safer behavior: in dry-run mode no files are modified
    """
    
    import argparse
    from datetime import datetime, date, timezone
    import csv
    import re
    from pathlib import Path
    import shutil
    import sys
    
    PRIVACY_DIR = Path('/workspace/privacy')
    LEDGER = PRIVACY_DIR / 'consent_records.csv'
    RULES = PRIVACY_DIR / 'retention_rules.md'
    LOG = PRIVACY_DIR / 'prune.log'
    
    
    def parse_rules():
        """Extract cutoff date (R1), default hold years (R2), and min expiry 
year if present.
        """
        cutoff = date(2023, 1, 1)
        default_hold_years = 6
        min_expiry_date = None
        try:
            text = RULES.read_text()
        except Exception:
            return cutoff, default_hold_years, min_expiry_date
        # R1: look for a date like 2023-01-01 on the R1 line
        m = re.search(r'R1\.[^\n]*(\d{4}-\d{2}-\d{2})', text)
        if m:
            try:
                cutoff = datetime.strptime(m.group(1), '%Y-%m-%d').date()
            except Exception:
                pass
        # R2: look for an art7-6y style pattern to extract years
        m2 = re.search(r'art7-(\d+)y', text)
        if m2:
            try:
                default_hold_years = int(m2.group(1))
            except Exception:
                pass
        # detect minimum expiry year e.g. 'expire in 2029'
        m3 = re.search(r'expire(?:s)? in (\d{4})', text)
        if m3:
            try:
                year = int(m3.group(1))
                min_expiry_date = date(year, 1, 1)
            except Exception:
                pass
        return cutoff, default_hold_years, min_expiry_date
    
    
    def add_years(d: date, years: int) -> date:
        """Return a date plus given number of years, adjusting Feb 29 to Feb 
28."""
        try:
            return d.replace(year=d.year + years)
        except ValueError:
            return d.replace(month=2, day=28, year=d.year + years)
    
    
    def hold_expiry(recorded_at_str: str, statutory_hold: str, 
default_hold_years: int, min_expiry_date):
        """Return expiry date for a statutory_hold string, or None if no 
hold."""
        if not statutory_hold or statutory_hold.strip().lower() == 'none':
            return None
        m = re.search(r'(\d+)', statutory_hold)
        years = default_hold_years
        if m:
            try:
                years = int(m.group(1))
            except Exception:
                years = default_hold_years
        try:
            recorded_date = datetime.strptime(recorded_at_str, 
'%Y-%m-%d').date()
        except Exception:
            return date(9999, 12, 31)
        expiry = add_years(recorded_date, years)
        if min_expiry_date and expiry < min_expiry_date:
            return min_expiry_date
        return expiry
    
    
    def backup_file(src: Path):
        if not src.exists():
            return None
        ts = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
        dst = src.with_name(f"{src.name}.backup.{ts}")
        shutil.copy2(src, dst)
        return dst
    
    
    def load_ledger(path: Path):
        with path.open(newline='') as csvfile:
            reader = csv.DictReader(csvfile)
            header = reader.fieldnames
            rows = [r for r in reader if r and any((v or '').strip() for v in 
r.values())]
        return header, rows
    
    
    def write_ledger(path: Path, header, rows):
        if not header:
            header = ['subject_id', 'channel', 'consent_state', 'recorded_at', 
'statutory_hold']
        with path.open('w', newline='') as csvfile:
            writer = csv.DictWriter(csvfile, fieldnames=header)
            writer.writeheader()
            for r in rows:
                writer.writerow(r)
    
    
    def append_log(entries):
        if not entries:
            return
        LOG.parent.mkdir(parents=True, exist_ok=True)
        ts = datetime.now(timezone.utc).isoformat()
        with LOG.open('a') as lf:
            for row, reason in entries:
                csv_snippet = ','.join([
                    row.get('subject_id', ''), row.get('channel', ''), 
row.get('consent_state', ''), row.get('recorded_at', ''), 
row.get('statutory_hold', '')
                ])
                lf.write(f"{ts} - REMOVED - {csv_snippet} - {reason}\n")
    
    
    def main(argv):
        parser = argparse.ArgumentParser(description='Prune consent ledger per 
retention rules')
        parser.add_argument('--dry-run', action='store_true', help='Do not 
modify files; only show what would be removed')
        parser.add_argument('--no-backup', action='store_true', help='Do not 
create a timestamped backup before modifying the ledger')
        parser.add_argument('--ledger', type=Path, default=LEDGER, help='Path to
consent_records.csv')
        args = parser.parse_args(argv)
    
        cutoff, default_hold_years, min_expiry_date = parse_rules()
        today = date.today()
    
        if not args.ledger.exists():
            print(f"Ledger not found at {args.ledger}")
            return 1
    
        header, rows = load_ledger(args.ledger)
        kept = []
        removed = []
    
        for row in rows:
            subject_id = (row.get('subject_id') or '').strip()
            consent_state = (row.get('consent_state') or '').strip().lower()
            recorded_at = (row.get('recorded_at') or '').strip()
            statutory_hold = (row.get('statutory_hold') or '').strip().lower() 
or 'none'
    
            if statutory_hold != 'none':
                expiry = hold_expiry(recorded_at, statutory_hold, 
default_hold_years, min_expiry_date)
                if expiry and today >= expiry:
                    reason = f"statutory hold {statutory_hold} expired on 
{expiry.isoformat()}"
                    removed.append((row, reason))
                else:
                    kept.append(row)
                continue
    
            try:
                rec_date = datetime.strptime(recorded_at, '%Y-%m-%d').date()
            except Exception:
                kept.append(row)
                continue
    
            if consent_state == 'granted' and rec_date < cutoff:
                reason = f"grant older than cutoff {cutoff.isoformat()}"
                removed.append((row, reason))
            else:
                kept.append(row)
    
        # report
        if args.dry_run:
            print(f"Prune analysis: {len(removed)} rows would be removed.")
        else:
            print(f"Prune pass: removing {len(removed)} rows.")
        for row, reason in removed:
            print(f"- {row.get('subject_id','?')} ({row.get('recorded_at','?')})
- {reason}")
    
        if not removed:
            print("No removals necessary.")
            return 0
    
        if args.dry_run:
            return 0
    
        if not args.no_backup:
            b = backup_file(args.ledger)
            if b:
                print(f"Backup created at {b}")
    
        append_log(removed)
        write_ledger(args.ledger, header, kept)
        print("Ledger updated in place.")
        return 0
    
    
    if __name__ == '__main__':
        sys.exit(main(sys.argv[1:]))
    

