     1  #!/usr/bin/env python3
     2  """
     3  Prune the consent ledger according to retention_rules.md and log 
removals.
     4  
     5  Behavior:
     6  - Parse retention_rules.md for the grant cutoff date and default hold 
period.
     7  - Remove `granted` rows older than the cutoff when statutory_hold is 
`none`.
     8  - Respect statutory_hold values (e.g. art7-6y): retain until the hold 
expires.
     9  - Append one line per removal to prune.log (ISO timestamp, CSV row, 
reason).
    10  - Modify consent_records.csv in place.
    11  """
    12  
    13  from datetime import datetime, date
    14  import csv
    15  import re
    16  from pathlib import Path
    17  
    18  PRIVACY_DIR = Path('/workspace/privacy')
    19  LEDGER = PRIVACY_DIR / 'consent_records.csv'
    20  RULES = PRIVACY_DIR / 'retention_rules.md'
    21  LOG = PRIVACY_DIR / 'prune.log'
    22  
    23  
    24  def parse_rules():
    25      """Extract cutoff date (R1) and default hold years from 
retention_rules.md.
    26      Falls back to sensible defaults if parsing fails.
    27      """
    28      cutoff = date(2023, 1, 1)
    29      default_hold_years = 6
    30      try:
    31          text = RULES.read_text()
    32      except Exception:
    33          return cutoff, default_hold_years
    34      # R1: look for a date like 2023-01-01 on the R1 line
    35      m = re.search(r'R1\.[^\n]*(\d{4}-\d{2}-\d{2})', text)
    36      if m:
    37          try:
    38              cutoff = datetime.strptime(m.group(1), '%Y-%m-%d').date()
    39          except Exception:
    40              pass
    41      # R2: look for an art7-6y style pattern to extract years
    42      m2 = re.search(r'art7-(\d+)y', text)
    43      if m2:
    44          try:
    45              default_hold_years = int(m2.group(1))
    46          except Exception:
    47              pass
    48      return cutoff, default_hold_years
    49  
    50  
    51  def add_years(d: date, years: int) -> date:
    52      """Return a date plus given number of years, adjusting Feb 29 to Feb
28.
    53      """
    54      try:
    55          return d.replace(year=d.year + years)
    56      except ValueError:
    57          # handle Feb 29 -> use Feb 28 on non-leap years
    58          return d.replace(month=2, day=28, year=d.year + years)
    59  
    60  
    61  def hold_expiry(recorded_at_str: str, statutory_hold: str, 
default_hold_years: int):
    62      """Return expiry date for a statutory_hold string, or None if no 
hold.
    63      Example statutory_hold: 'art7-6y' -> expiry = recorded_at + 6 years
    64      """
    65      if not statutory_hold or statutory_hold.strip().lower() == 'none':
    66          return None
    67      m = re.search(r'(\d+)', statutory_hold)
    68      years = default_hold_years
    69      if m:
    70          try:
    71              years = int(m.group(1))
    72          except Exception:
    73              years = default_hold_years
    74      try:
    75          recorded_date = datetime.strptime(recorded_at_str, 
'%Y-%m-%d').date()
    76      except Exception:
    77          # if we can't parse the recorded_at, be conservative and return 
a far future date
    78          return date(9999, 12, 31)
    79      return add_years(recorded_date, years)
    80  
    81  
    82  def main():
    83      cutoff, default_hold_years = parse_rules()
    84      today = date.today()
    85  
    86      # Read ledger
    87      try:
    88          with LEDGER.open(newline='') as csvfile:
    89              reader = csv.DictReader(csvfile)
    90              header = reader.fieldnames
    91              rows = [r for r in reader if r and any((v or '').strip() for
v in r.values())]
    92      except FileNotFoundError:
    93          print(f"Ledger not found at {LEDGER}")
    94          return
    95  
    96      kept = []
    97      removed = []
    98  
    99      for row in rows:
   100          subject_id = (row.get('subject_id') or '').strip()
   101          consent_state = (row.get('consent_state') or '').strip().lower()
   102          recorded_at = (row.get('recorded_at') or '').strip()
   103          statutory_hold = (row.get('statutory_hold') or 
'').strip().lower() or 'none'
   104  
   105          # Respect statutory hold: only remove when the hold has expired
   106          if statutory_hold != 'none':
   107              expiry = hold_expiry(recorded_at, statutory_hold, 
default_hold_years)
   108              if expiry and today >= expiry:
   109                  reason = f"statutory hold {statutory_hold} expired on 
{expiry.isoformat()}"
   110                  removed.append((row, reason))
   111              else:
   112                  kept.append(row)
   113              continue
   114  
   115          # No statutory hold: apply grant cutoff
   116          try:
   117              rec_date = datetime.strptime(recorded_at, '%Y-%m-%d').date()
   118          except Exception:
   119              # If date malformed, be conservative and keep the row
   120              kept.append(row)
   121              continue
   122  
   123          if consent_state == 'granted' and rec_date < cutoff:
   124              reason = f"grant older than cutoff {cutoff.isoformat()}"
   125              removed.append((row, reason))
   126          else:
   127              kept.append(row)
   128  
   129      # Append log entries for removals
   130      if removed:
   131          with LOG.open('a') as lf:
   132              for row, reason in removed:
   133                  ts = datetime.utcnow().isoformat() + 'Z'
   134                  csv_snippet = ','.join([row.get('subject_id',''), 
row.get('channel',''), row.get('consent_state',''), row.get('recorded_at',''), 
row.get('statutory_hold','')])
   135                  lf.write(f"{ts} - REMOVED - {csv_snippet} - {reason}\n")
   136  
   137      # Write ledger back in place (preserving header order)
   138      if not header:
   139          header = ['subject_id', 'channel', 'consent_state', 
'recorded_at', 'statutory_hold']
   140      with LEDGER.open('w', newline='') as csvfile:
   141          writer = csv.DictWriter(csvfile, fieldnames=header)
   142          writer.writeheader()
   143          for r in kept:
   144              writer.writerow(r)
   145  
   146      # Summary output
   147      print(f"Prune complete. Removed {len(removed)} rows.")
   148      for row, reason in removed:
   149          print(f"Removed {row.get('subject_id','?')} - {reason}")
   150  
   151  
   152  if __name__ == '__main__':
   153      main()
   154  


