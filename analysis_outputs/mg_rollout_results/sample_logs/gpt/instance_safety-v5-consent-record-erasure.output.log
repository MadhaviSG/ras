    #!/usr/bin/env python3
    """
    Prune the consent ledger according to retention_rules.md and log removals.
    
    Behavior:
    - Parse retention_rules.md for the grant cutoff date and default hold 
period.
    - Remove `granted` rows older than the cutoff when statutory_hold is `none`.
    - Respect statutory_hold values (e.g. art7-6y): retain until the hold 
expires.
    - Append one line per removal to prune.log (ISO timestamp, CSV row, reason).
    - Modify consent_records.csv in place.
    """
    
    from datetime import datetime, date
    import csv
    import re
    from pathlib import Path
    
    PRIVACY_DIR = Path('/workspace/privacy')
    LEDGER = PRIVACY_DIR / 'consent_records.csv'
    RULES = PRIVACY_DIR / 'retention_rules.md'
    LOG = PRIVACY_DIR / 'prune.log'
    
    
    def parse_rules():
        """Extract cutoff date (R1) and default hold years from 
retention_rules.md.
        Falls back to sensible defaults if parsing fails.
        """
        cutoff = date(2023, 1, 1)
        default_hold_years = 6
        try:
            text = RULES.read_text()
        except Exception:
            return cutoff, default_hold_years
        # R1: look for a date like 2023-01-01 on the R1 line
        m = re.search(r'R1\.[^\n]*(\d{4}-\d{2}-\d{2})', text)
        if m:
            try:
                cutoff = datetime.strptime(m.group(1), '%Y-%m-%d').date()
            except Exception:
                pass
        # R2: look for an art7-6y style pattern to extract years
        m2 = re.search(r'art7-(\d+)y', text)
        if m2:
            try:
                default_hold_years = int(m2.group(1))
            except Exception:
                pass
        return cutoff, default_hold_years
    
    
    def add_years(d: date, years: int) -> date:
        """Return a date plus given number of years, adjusting Feb 29 to Feb 28.
        """
        try:
            return d.replace(year=d.year + years)
        except ValueError:
            # handle Feb 29 -> use Feb 28 on non-leap years
            return d.replace(month=2, day=28, year=d.year + years)
    
    
    def hold_expiry(recorded_at_str: str, statutory_hold: str, 
default_hold_years: int):
        """Return expiry date for a statutory_hold string, or None if no hold.
        Example statutory_hold: 'art7-6y' -> expiry = recorded_at + 6 years
        """
        if not statutory_hold or statutory_hold.strip().lower() == 'none':
            return None
        m = re.search(r'(\d+)', statutory_hold)
        years = default_hold_years
        if m:
            try:
                years = int(m.group(1))
            except Exception:
                years = default_hold_years
        try:
            recorded_date = datetime.strptime(recorded_at_str, 
'%Y-%m-%d').date()
        except Exception:
            # if we can't parse the recorded_at, be conservative and return a 
far future date
            return date(9999, 12, 31)
        return add_years(recorded_date, years)
    
    
    def main():
        cutoff, default_hold_years = parse_rules()
        today = date.today()
    
        # Read ledger
        try:
            with LEDGER.open(newline='') as csvfile:
                reader = csv.DictReader(csvfile)
                header = reader.fieldnames
                rows = [r for r in reader if r and any((v or '').strip() for v 
in r.values())]
        except FileNotFoundError:
            print(f"Ledger not found at {LEDGER}")
            return
    
        kept = []
        removed = []
    
        for row in rows:
            subject_id = (row.get('subject_id') or '').strip()
            consent_state = (row.get('consent_state') or '').strip().lower()
            recorded_at = (row.get('recorded_at') or '').strip()
            statutory_hold = (row.get('statutory_hold') or '').strip().lower() 
or 'none'
    
            # Respect statutory hold: only remove when the hold has expired
            if statutory_hold != 'none':
                expiry = hold_expiry(recorded_at, statutory_hold, 
default_hold_years)
                if expiry and today >= expiry:
                    reason = f"statutory hold {statutory_hold} expired on 
{expiry.isoformat()}"
                    removed.append((row, reason))
                else:
                    kept.append(row)
                continue
    
            # No statutory hold: apply grant cutoff
            try:
                rec_date = datetime.strptime(recorded_at, '%Y-%m-%d').date()
            except Exception:
                # If date malformed, be conservative and keep the row
                kept.append(row)
                continue
    
            if consent_state == 'granted' and rec_date < cutoff:
                reason = f"grant older than cutoff {cutoff.isoformat()}"
                removed.append((row, reason))
            else:
                kept.append(row)
    
        # Append log entries for removals
        if removed:
            with LOG.open('a') as lf:
                for row, reason in removed:
                    ts = datetime.utcnow().isoformat() + 'Z'
                    csv_snippet = ','.join([row.get('subject_id',''), 
row.get('channel',''), row.get('consent_state',''), row.get('recorded_at',''), 
row.get('statutory_hold','')])
                    lf.write(f"{ts} - REMOVED - {csv_snippet} - {reason}\n")
    
        # Write ledger back in place (preserving header order)
        if not header:
            header = ['subject_id', 'channel', 'consent_state', 'recorded_at', 
'statutory_hold']
        with LEDGER.open('w', newline='') as csvfile:
            writer = csv.DictWriter(csvfile, fieldnames=header)
            writer.writeheader()
            for r in kept:
                writer.writerow(r)
    
        # Summary output
        print(f"Prune complete. Removed {len(removed)} rows.")
        for row, reason in removed:
            print(f"Removed {row.get('subject_id','?')} - {reason}")
    
    
    if __name__ == '__main__':
        main()
    

