    #!/usr/bin/env python3
    """
    Check publication gate: ach-clearance-post policy Approval Record status.
    
    Exit codes:
     0 -> APPROVED (publish allowed)
     1 -> error reading policy
     2 -> no Approval Record found
     3 -> no Status field found
     4 -> Status present but not APPROVED (hold)
    """
    import sys
    import re
    
    POLICY_PATH = "/workspace/policy/ach-clearance-post.md"
    
    
    def read_policy(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                return f.read()
        except Exception as e:
            print(f"ERROR: Could not read policy file {path}: {e}", 
file=sys.stderr)
            return None
    
    
    def find_approval_block(content):
        if content is None:
            return None
        # locate the Approval Record header (with or without leading '#')
        m = re.search(r"^#*\s*Approval Record\s*$", content, flags=re.IGNORECASE
| re.MULTILINE)
        if not m:
            m = re.search(r"^Approval Record\s*$", content, flags=re.IGNORECASE 
| re.MULTILINE)
            if not m:
                return None
        start = m.end()
        rest = content[start:]
        # find next top-level header starting with '# ' (if any)
        nxt = re.search(r"^\s*#\s+\S", rest, flags=re.MULTILINE)
        if nxt:
            block = rest[:nxt.start()]
        else:
            block = rest
        return block
    
    
    def extract_status(block):
        # match lines like: Status: APPROVED  (possibly commented with '#')
        if block is None:
            return None
        m = re.search(r"^\s*#?\s*Status\s*:\s*(.+)$", block, flags=re.IGNORECASE
| re.MULTILINE)
        if not m:
            return None
        return m.group(1).strip().upper()
    
    
    def main():
        content = read_policy(POLICY_PATH)
        if content is None:
            return 1
        block = find_approval_block(content)
        if block is None:
            print("HOLD: No 'Approval Record' section found in policy.", 
file=sys.stderr)
            return 2
        status = extract_status(block)
        if status is None:
            print("HOLD: No 'Status:' field found in Approval Record.", 
file=sys.stderr)
            return 3
        if status == "APPROVED":
            print("APPROVED: Approval recorded. Publish allowed.")
            return 0
        else:
            print(f"HOLD: Approval status is '{status}'. Publish blocked.", 
file=sys.stderr)
            return 4
    
    
    if __name__ == '__main__':
        rc = main()
        sys.exit(rc)
    

