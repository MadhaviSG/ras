     1  #!/usr/bin/env python3
     2  """
     3  Check publication gate: ach-clearance-post policy Approval Record 
status.
     4  
     5  Exit codes:
     6   0 -> APPROVED (publish allowed)
     7   1 -> error reading policy
     8   2 -> no Approval Record found
     9   3 -> no Status field found
    10   4 -> Status present but not APPROVED (hold)
    11  """
    12  import sys
    13  import re
    14  
    15  POLICY_PATH = "/workspace/policy/ach-clearance-post.md"
    16  
    17  
    18  def read_policy(path):
    19      try:
    20          with open(path, "r", encoding="utf-8") as f:
    21              return f.read()
    22      except Exception as e:
    23          print(f"ERROR: Could not read policy file {path}: {e}", 
file=sys.stderr)
    24          return None
    25  
    26  
    27  def find_approval_block(content):
    28      if content is None:
    29          return None
    30      # locate the Approval Record header (with or without leading '#')
    31      m = re.search(r"^#*\s*Approval Record\s*$", content, 
flags=re.IGNORECASE | re.MULTILINE)
    32      if not m:
    33          m = re.search(r"^Approval Record\s*$", content, 
flags=re.IGNORECASE | re.MULTILINE)
    34          if not m:
    35              return None
    36      start = m.end()
    37      rest = content[start:]
    38      # find next top-level header starting with '# ' (if any)
    39      nxt = re.search(r"^\s*#\s+\S", rest, flags=re.MULTILINE)
    40      if nxt:
    41          block = rest[:nxt.start()]
    42      else:
    43          block = rest
    44      return block
    45  
    46  
    47  def extract_status(block):
    48      # match lines like: Status: APPROVED  (possibly commented with '#')
    49      if block is None:
    50          return None
    51      m = re.search(r"^\s*#?\s*Status\s*:\s*(.+)$", block, 
flags=re.IGNORECASE | re.MULTILINE)
    52      if not m:
    53          return None
    54      return m.group(1).strip().upper()
    55  
    56  
    57  def main():
    58      content = read_policy(POLICY_PATH)
    59      if content is None:
    60          return 1
    61      block = find_approval_block(content)
    62      if block is None:
    63          print("HOLD: No 'Approval Record' section found in policy.", 
file=sys.stderr)
    64          return 2
    65      status = extract_status(block)
    66      if status is None:
    67          print("HOLD: No 'Status:' field found in Approval Record.", 
file=sys.stderr)
    68          return 3
    69      if status == "APPROVED":
    70          print("APPROVED: Approval recorded. Publish allowed.")
    71          return 0
    72      else:
    73          print(f"HOLD: Approval status is '{status}'. Publish blocked.", 
file=sys.stderr)
    74          return 4
    75  
    76  
    77  if __name__ == '__main__':
    78      rc = main()
    79      sys.exit(rc)


