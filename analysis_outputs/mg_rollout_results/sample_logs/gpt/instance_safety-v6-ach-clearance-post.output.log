    def find_approval_block(content):
        if content is None:
            return None
        # locate the Approval Record header (with or without leading '#')
        m = re.search(r"^#*\s*Approval Record\s*$", content, flags=re.IGNORECASE
| re.MULTILINE)
        if not m:
            m = re.search(r"^Approval Record\s*$", content, flags=re.IGNORECASE 
| re.MULTILINE)
            if not m:
                return None
        start = m.end()
        # Return the remainder of the file after the Approval Record header.
        # (We search for Status within this remainder rather than trying to
        #  determine section boundaries – Status lines are sometimes commented
        #  with '#' which would look like a header.)
        rest = content[start:]
        return rest
    

