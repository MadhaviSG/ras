        print('SEARCH_MSGS', sm.status_code)
        print(sm.text[:1000])
        # list files
        fl = requests.get(rc_url + '/api/v1/files.list?count=50', 
headers=headers, timeout=15)
        print('FILES_LIST', fl.status_code)
        print(fl.text[:1000])
    else:
        print('LOGIN_FAILED', r.text[:1000])
except Exception as e:
    print('ERROR', e)
